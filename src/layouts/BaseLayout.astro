---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  lang?: 'fr-CA' | 'en-CA';
  alternateHref?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  robots?: string;
}

const {
  title,
  description = 'Tales from the Scarf — Nicolas Georgeault',
  image,
  imageAlt,
  lang = 'fr-CA',
  alternateHref,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const isEnglish = lang === 'en-CA';
const homeHref = isEnglish ? `${base}en-ca/` : base;
const articlesHref = `${homeHref}#articles`;
const technologiesHref = isEnglish ? `${base}en-ca/technology/` : `${base}technologies/`;
const communitiesHref = isEnglish ? `${base}en-ca/communities/` : `${base}communautes/`;
const personalHref = isEnglish ? `${base}en-ca/personal-notes/` : `${base}carnets-personnels/`;
const searchHref = isEnglish ? `${base}en-ca/search/` : `${base}recherche/`;
const switchTarget = alternateHref ?? (isEnglish ? base : `${base}en-ca/`);

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const alternateUrl = alternateHref ? new URL(alternateHref, siteUrl).toString() : undefined;
const socialImage = image ? new URL(image, siteUrl).toString() : undefined;
const ogLocale = isEnglish ? 'en_CA' : 'fr_CA';
const alternateLocale = isEnglish ? 'fr_CA' : 'en_CA';
const keywords = tags.length > 0 ? tags.join(', ') : undefined;

const structuredData = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      inLanguage: lang,
      ...(socialImage ? { image: [socialImage] } : {}),
      ...(publishedTime ? { datePublished: publishedTime } : {}),
      ...(modifiedTime || publishedTime ? { dateModified: modifiedTime ?? publishedTime } : {}),
      ...(author ? { author: { '@type': 'Person', name: author } } : {}),
      ...(keywords ? { keywords } : {}),
      isPartOf: {
        '@type': 'WebSite',
        name: 'Tales from the Scarf',
        url: new URL(base, siteUrl).toString(),
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonicalUrl,
      inLanguage: lang,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Tales from the Scarf',
        url: new URL(base, siteUrl).toString(),
      },
    };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {author && <meta name="author" content={author} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    {alternateUrl && (
      <link rel="alternate" hreflang={isEnglish ? 'fr-CA' : 'en-CA'} href={alternateUrl} />
    )}
    <link
      rel="alternate"
      hreflang="x-default"
      href={isEnglish && alternateUrl ? alternateUrl : canonicalUrl}
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Tales from the Scarf" />
    <meta property="og:locale" content={ogLocale} />
    {alternateUrl && <meta property="og:locale:alternate" content={alternateLocale} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && (modifiedTime || publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
    )}
    {type === 'article' && tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>

    {import.meta.env.PUBLIC_UMAMI_SCRIPT_URL && import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        defer
        src={import.meta.env.PUBLIC_UMAMI_SCRIPT_URL}
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        data-domains={import.meta.env.PUBLIC_UMAMI_DOMAINS || undefined}
        data-performance="true"
      ></script>
    )}
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-background text-foreground">
    <header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-xl">
      <div class="container flex h-18 items-center justify-between gap-4">
        <a class="font-display text-xl font-bold tracking-tight" href={homeHref}>
          Tales from the Scarf
        </a>

        <nav class="hidden items-center gap-1 lg:flex">
          <a class="nav-link nav-link-inactive rounded-md px-3 py-2 text-sm transition-colors" href={homeHref}>
            {isEnglish ? 'Home' : 'Accueil'}
          </a>
          <a class="nav-link nav-link-inactive rounded-md px-3 py-2 text-sm transition-colors" href={technologiesHref}>
            {isEnglish ? 'Technology' : 'Technologies'}
          </a>
          <a class="nav-link nav-link-inactive rounded-md px-3 py-2 text-sm transition-colors" href={communitiesHref}>
            {isEnglish ? 'Communities' : 'Communautés'}
          </a>
          <a class="nav-link nav-link-inactive rounded-md px-3 py-2 text-sm transition-colors" href={personalHref}>
            {isEnglish ? 'Personal notes' : 'Carnets personnels'}
          </a>
          <a class="nav-link nav-link-inactive rounded-md px-3 py-2 text-sm transition-colors" href={searchHref}>
            {isEnglish ? 'Search' : 'Recherche'}
          </a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            class="inline-flex items-center justify-center rounded-md border border-border bg-background-secondary px-3 py-2 text-sm font-semibold transition-colors hover:bg-background-tertiary lg:hidden"
            href={searchHref}
            aria-label={isEnglish ? 'Search' : 'Rechercher'}
            title={isEnglish ? 'Search' : 'Rechercher'}
          >⌕</a>
          <label class="sr-only" for="locale-select">{isEnglish ? 'Language' : 'Langue'}</label>
          <select
            id="locale-select"
            class="rounded-md border border-border bg-background-secondary px-3 py-2 text-sm font-semibold text-foreground shadow-sm outline-none transition-colors hover:bg-background-tertiary"
            data-target={switchTarget}
          >
            <option value="fr-CA" selected={!isEnglish}>FR-CA</option>
            <option value="en-CA" selected={isEnglish}>EN-CA</option>
          </select>

          <button
            id="theme-toggle"
            class="rounded-md border border-border bg-background-secondary px-3 py-2 text-sm font-semibold hover:bg-background-tertiary"
            aria-label={isEnglish ? 'Toggle theme' : 'Changer de thème'}
          >
            ◐
          </button>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="border-t border-border bg-background-secondary">
      <div class="container py-10 text-sm text-foreground-muted">
        <div class="flex flex-col justify-between gap-3 md:flex-row">
          <span>{isEnglish ? 'Astro + OKF migration sandbox for georgeault.net.' : 'POC Astro + OKF — simulation isolée de georgeault.net.'}</span>
          <span>{isEnglish ? 'Velocity presentation layer.' : 'Présentation basée sur Velocity.'}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });

      const localeSelect = document.getElementById('locale-select');
      localeSelect?.addEventListener('change', (event) => {
        const target = localeSelect.dataset.target;
        if (target) window.location.href = target;
      });
    </script>
  </body>
</html>
